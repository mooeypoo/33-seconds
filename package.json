{
  "name": "thirty-three-seconds",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "description": "33 Seconds -- a pixel-art survivors-style browser shooter. Unofficial fan project.",
  "homepage": "https://33seconds.netlify.app/",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-dev-tools-stripped.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:arch": "depcruise src tools --config .dependency-cruiser.cjs",
    "check:content": "vitest run --config vitest.content.config.ts",
    "sim": "vitest run --config vitest.sim.config.ts --reporter=verbose",
    "check:guardrails": "node scripts/prove-guardrails.mjs",
    "render:share": "node scripts/render-share-images.mjs"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "vue": "3.5.43",
    "zzfx": "1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.11"
  }
}
