{
  "speaker": "roslin",
  "pools": [
    {
      "trigger": "ResurrectionShipArrived",
      "priority": "normal",
      "cooldownSeconds": 30,
      "lines": [
        { "id": "roslin-resurrection-ship-arrived-01", "text": "Destroy the ship, and we buy real time." },
        { "id": "roslin-resurrection-ship-arrived-02", "text": "Take it down before it multiplies the problem." },
        { "id": "roslin-resurrection-ship-arrived-03", "text": "One factory. One priority." },
        { "id": "roslin-resurrection-ship-arrived-04", "text": "I taught grade school. This is somehow calmer." },
        { "id": "roslin-resurrection-ship-arrived-05", "text": "Every ship we down without it is a mercy." },
        { "id": "roslin-resurrection-ship-arrived-06", "text": "Send the Vipers. This one doesn't get to finish." }
      ]
    },
    {
      "trigger": "RunWon",
      "priority": "normal",
      "cooldownSeconds": 600,
      "lines": [
        { "id": "roslin-run-won-01", "text": "We live to jump again. That's the whole plan." },
        { "id": "roslin-run-won-02", "text": "The fleet holds. That's the only vote that matters." },
        { "id": "roslin-run-won-03", "text": "Not bad, for the forty-third in line." }
      ]
    },
    {
